generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("TECHNICIAN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  audits       AuditLog[]
}

model AppState {
  key       String   @id
  value     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Ticket {
  id                String   @id
  customer          String
  phone             String
  device            String
  // Kind of item (Laptop, Komputer / PC, Monitor, ...), picked from the shop's
  // editable list (ShopSettings.deviceTypes). Null on jobs imported from the old app.
  deviceType        String?
  // JSON [{name, amount}]: itemised price lines for the receipt, nota and cost message.
  costItems         String?
  // Date the customer was asked how the unit is doing after pickup (follow-up list).
  followedUpAt      String?
  brand             String
  serial            String   @default("-")
  issue             String
  accessories       String   @default("Unit only")
  technician        String
  status            String
  estimate          Int      @default(0)
  downPayment       Int      @default(0)
  finalCost         Int?
  receivedAt        String
  receivedTime      String?
  updatedAt         String
  statusChangedAt   String?
  rating            Int?
  customerConfirmed Boolean  @default(false)
  costConfirmed     Boolean  @default(false)
  category          String?
  address           String?
  condition         String?
  serviceAction     String?
  paymentMethod     String?
  paymentTermDays   Int?
  warrantyDays      Int?
  pickedUpAt        String?
  pickedUpTime      String?
  handledAt         String?
  handledTime       String?
  notes             String?
  partCost          Int?
  pickupBy          String?
  handedBy          String?
  // Who took the unit in (the old app's "Penerima"); `technician` is who worked on it.
  receivedBy        String?
  // Set when this ticket is a warranty claim: the id of the original service.
  warrantyOf        String?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  dbUpdatedAt       DateTime @updatedAt
  @@index([status])
  @@index([phone])
  @@index([serial])
  @@index([warrantyOf])
}

model Customer {
  id                String   @id
  name              String
  category          String
  phone             String
  // Same phone as `phone` in canonical 62xxxxxxxxxx form. `phone` keeps
  // whatever format the customer was typed in (existing UI displays it
  // as-is), but duplicate detection and cross-referencing against
  // Ticket.phone need a consistent value to compare — 08xx and 62xx
  // strings for the same real number used to compare unequal. Optional +
  // unique (not required) so SQLite allows multiple NULLs during backfill.
  phoneNormalized   String?  @unique
  address           String
  rating            Int      @default(0)
  createdAt         String
  version           Int      @default(1)
  dbUpdatedAt       DateTime @updatedAt
  @@index([phone])
}

model ServiceItem {
  id           String @id
  name         String
  partCost     Int
  shopPrice    Int
  userPrice    Int
  warrantyDays Int
  version      Int    @default(1)
}

model ShopSettings {
  id          String   @id @default("default")
  name        String
  phone       String
  whatsapp    String
  address     String
  description String
  terms       String
  bank        String
  // Social handles printed on the receipt footer (stored without the "@").
  instagram   String   @default("fscomp_id")
  tiktok      String   @default("fscomp_id")
  // Kinds of item offered at intake, one per line. Not part of the Profil Toko
  // PATCH: it is changed only through /api/shop/device-types so a stale
  // settings form can never overwrite a type someone just added.
  deviceTypes String   @default("Laptop\nKomputer / PC\nMonitor\nPrinter\nLainnya")
  // Master switch for the QC (cek awal) feature. Off: the checklist, review panel,
  // review alerts and the intern desk are all inactive; saved QC data is kept.
  qcEnabled   Boolean  @default(true)
  // Google Maps "write a review" link; when set, a QR for it is printed on the nota for every customer.
  reviewUrl   String   @default("")
  lockEnabled Boolean  @default(false)
  // Editable WhatsApp message templates (see lib/wa-templates.ts for the
  // {placeholder} substitution and defaults matching the previous
  // hardcoded copy). Salutation/closing wrap every customer-facing
  // template; the three bodies are the message-specific middle section.
  waSalutation   String @default("Assalamu'alaikum warahmatullahi wabarakatuh, Kak {nama}")
  waClosing      String @default("Jazakallahu khoiron 🤲😊")
  waReceived     String @default("Terima kasih sudah mempercayakan servis {perangkat} kepada *{toko}*. Semoga Allah membalas kepercayaan Kakak dengan kebaikan. Barang Kakak sudah kami terima dengan nomor servis *{nomor_servis}* pada {tanggal_terima}.\n\nPerkembangan servis dapat dicek kapan saja melalui link berikut:\n{link_tracking}\n\nJika link belum dapat dibuka, silakan simpan nomor WhatsApp kami terlebih dahulu. Insya Allah kami akan mengabari kembali saat ada perkembangan.")
  waCost         String @default("Kami sudah melakukan pengecekan {perangkat}. Untuk penanganan *{tindakan}*, estimasi biaya servisnya adalah *{estimasi}*.{rincian}\n\nApakah servisnya boleh kami lanjutkan? Mohon balas *LANJUT* atau *TIDAK*. Jika ada yang ingin ditanyakan, silakan sampaikan ya, insya Allah kami bantu.")
  waCostOptions  String @default("Alhamdulillah, hasil pengecekan {perangkat} sudah selesai. Kami menawarkan pilihan penanganan berikut:\n\n1. Perbaikan utama — *{estimasi}*\n2. Perbaikan tanpa penggantian komponen — silakan konfirmasi\n3. Tidak dilanjutkan\n\nMohon balas nomor pilihan yang diinginkan. Kami belum mengerjakan sebelum mendapat persetujuan dari Kakak.")
  waReady        String @default("Alhamdulillah, servis {perangkat} Kakak dengan nomor *{nomor_servis}* sudah selesai dan siap diambil.\n\n{detail}{pembayaran}\n\nDetail dan status servis dapat dicek kapan saja di:\n{link_tracking}\n\nSilakan datang ke *{toko}* dengan membawa tanda terima atau menunjukkan nomor servis. Terima kasih atas kepercayaannya.")
  waPickedUp     String @default("Terima kasih sudah mempercayakan servis {perangkat} kepada *{toko}*. Unit dengan nomor servis *{nomor_servis}* sudah diambil.{garansi}\n\nJika ada kendala, pertanyaan, atau hal yang kurang berkenan, mohon kabari kami lebih dulu lewat chat WhatsApp ini. Insya Allah segera kami bantu dan carikan solusinya. Masukan Kakak sangat berarti untuk perbaikan layanan kami.")
  waFollowUp     String @default("Kami dari *{toko}*. Unit {perangkat} (no. servis {nomor_servis}) sudah beberapa hari kembali ke Kakak, apakah berfungsi dengan baik?\n\nJika masih ada kendala atau ada yang kurang berkenan, kabari kami lewat chat ini ya. Insya Allah kami bantu secepatnya.")
  waNotFixed     String @default("Mohon maaf, servis {perangkat} Kakak dengan nomor *{nomor_servis}* {hasil}.\n\n{detail}{biaya_cek}\n\nUnit sudah dapat diambil di *{toko}* dengan membawa tanda terima atau menunjukkan nomor servis. Detail dan status servis dapat dicek kapan saja di:\n{link_tracking}\n\nJika ada pertanyaan, silakan balas chat ini, insya Allah kami bantu jelaskan. Terima kasih atas kepercayaannya.")
  waNotFixedFollowUp String @default("Kami dari *{toko}*. Unit {perangkat} (no. servis {nomor_servis}) beberapa hari lalu sudah kembali ke Kakak. Kami ingin memastikan penjelasan dan penanganan dari kami sudah jelas.\n\nJika masih ada yang ingin ditanyakan atau ada yang kurang berkenan, kabari kami lewat chat ini ya. Insya Allah kami bantu secepatnya.")
  version     Int      @default(1)
  dbUpdatedAt DateTime @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  ticketId        String
  amount          Int
  method          String
  note            String?
  createdBy       String
  // Client-supplied key so a retried/double-submitted request (network
  // blip, impatient double click) returns the existing row instead of
  // creating a second payment. Optional + unique — NULL for callers that
  // don't supply one, which SQLite allows any number of.
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  @@index([ticketId])
}

model ChatLog {
  id        String   @id @default(cuid())
  ticketId  String
  phone     String
  template  String
  message   String
  createdBy String
  createdAt DateTime @default(now())
  @@index([ticketId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([createdAt])
  @@index([entity, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// One QC (cek awal / diagnosa) submission for a job. Interns fill the
// checklist; a technician reviews it. Resubmitting adds a new row — the latest
// row per ticket is the current one.
model QcCheck {
  id          String    @id @default(cuid())
  ticketId    String
  stage       String    @default("DIAGNOSA")
  // Which checklist was used (Laptop, Komputer / PC, ...). Items are stored with
  // their labels so later template edits never rewrite history.
  template    String
  // JSON: [{ id, group, label, result: ok|bad|unsure|na, note }]
  items       String
  summary     String?
  // Typed name of whoever did the checking — interns share one login.
  checkedBy   String
  submittedBy String
  badCount    Int       @default(0)
  unsureCount Int       @default(0)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  @@index([ticketId])
}
